<?php
$depth = max(0, (int) $this->themeSetting('nav_depth'));
$escapeAttr = $this->plugin('escapeHtmlAttr');
$domain = $this->navigation($container)->getTranslatorTextDomain();
?>
<?php if ($depth === 0 || $level <= $depth): ?>
<ul>
    <?php foreach ($children as $child): ?>
    <?php if (!$this->navigation()->accept($child)) continue; ?>
    <?php if ($child->get('separator') === true): ?>
    <li class="divider" role="separator"></li>
    <?php continue; endif; ?>
    <li<?php if ($child->isActive(true)) echo ' class="active"'; ?>>
        <a href="<?php echo $escapeAttr($child->getHref()); ?>"<?php if ($child->getTarget()): ?> target="<?php echo $escapeAttr($child->getTarget()); ?>"<?php if ($child->getTarget() === '_blank') echo ' rel="noopener"'; ?><?php endif; ?>>
            <?php if ($child->get('icon')): ?>
            <span class="<?php echo $escapeAttr($child->get('icon')); ?>" aria-hidden="true"></span>
            <?php endif; ?>
            <?php echo $this->escapeHtml($this->translate($child->getLabel(), $domain)); ?>
        </a>
        <?php if ($child->hasPages() && ($depth === 0 || $level < $depth)): ?>
        <?php echo $this->partial('common/sub-navigation', ['container' => $container, 'children' => $child->getPages(), 'level' => $level + 1]); ?>
        <?php endif; ?>
    </li>
    <?php endforeach; ?>
</ul>
<?php endif; ?>
