<?php
/* @var $container Laminas\Navigation\Navigation */
$container = $this->container;
$depth = max(0, (int) $this->themeSetting('nav_depth'));
$escapeAttr = $this->plugin('escapeHtmlAttr');
$domain = $this->navigation($container)->getTranslatorTextDomain();
?>
<nav class="site-navigation" id="site-navigation" aria-label="<?php echo $escapeAttr($this->translate('Main navigation')); ?>">
    <ul class="navigation" id="site-navigation-list">
        <?php foreach ($container as $page): ?>
        <?php
        if (!$this->navigation()->accept($page)) continue;
        if ($page->get('separator') === true) continue;
        $hasChildren = false;
        if ($depth === 0 || $depth > 1) {
            foreach ($page->getPages() as $child) {
                if ($this->navigation()->accept($child) && $child->get('separator') !== true) {
                    $hasChildren = true;
                    break;
                }
            }
        }
        $label = $this->escapeHtml($this->translate($page->getLabel(), $domain));
        ?>
        <li<?php if ($page->isActive(true)) echo ' class="active"'; ?>>
            <a href="<?php echo $escapeAttr($page->getHref()); ?>"<?php if (!$hasChildren && $page->getTarget()): ?> target="<?php echo $escapeAttr($page->getTarget()); ?>"<?php if ($page->getTarget() === '_blank') echo ' rel="noopener"'; ?><?php endif; ?>><?php echo $label; ?></a>
            <?php if ($hasChildren): ?>
            <div class="sub-nav first">
                <a class="parent" href="<?php echo $escapeAttr($page->getHref()); ?>"<?php if ($page->getTarget()): ?> target="<?php echo $escapeAttr($page->getTarget()); ?>"<?php if ($page->getTarget() === '_blank') echo ' rel="noopener"'; ?><?php endif; ?>><?php echo $label; ?></a>
                <?php echo $this->partial('common/sub-navigation', ['container' => $container, 'children' => $page->getPages(), 'level' => 2]); ?>
            </div>
            <?php endif; ?>
        </li>
        <?php endforeach; ?>
    </ul>
</nav>
