<?php
// Arrays represent result lists; only individual resources show output links.
if (is_array($resources)) {
    return;
}
$metadataFormats = $this->plugin('MetadataFormats');
$links = $metadataFormats($resources);
$escape = $this->plugin('escapeHtml');
$escapeAttr = $this->plugin('escapeHtmlAttr');
$label = $this->translate('Metadata formats');
?>
<?php if ($links): ?>
<nav class="metadata-formats" aria-label="<?php echo $escapeAttr($label); ?>">
    <span><?php echo $escape($label); ?></span>
    <ul>
        <?php foreach ($links as $link): ?>
        <li><a href="<?php echo $escapeAttr($link['url']); ?>" type="<?php echo $escapeAttr($link['type']); ?>"><?php echo $escape($link['label']); ?></a></li>
        <?php endforeach; ?>
    </ul>
</nav>
<?php endif; ?>
