<?php
/**
 * Structured metadata view for a manuscript, printed book, or contained text.
 *
 * The Work page presents these resources inside transmission accordions. This
 * partial gives their own item pages the same editorial grouping and visual
 * hierarchy without repeating the accordion header or a link to the page the
 * visitor is already viewing.
 */
$escape = $this->plugin('escapeHtml');
$translate = $this->plugin('translate');
$lang = $this->lang();
$resourceClass = $resource->resourceClass();
$resourceClassTerm = $resourceClass ? $resourceClass->term() : null;
$containedWorkClasses = [
    'yido:SingleWorkInManuscript' => 'yido:Manuscript',
    'yido:SingleWorkInPrintedBook' => 'yido:PrintedBook',
];
$isContainedWork = isset($containedWorkClasses[$resourceClassTerm]);
$contextsInHoldings = $resourceClass && 'yido:PrintedBook' === $resourceClass->term();
$showValueAnnotations = $this->fallbackSetting('show_value_annotations', ['site'], true);

$this->htmlElement('body')->appendAttribute('class', 'witness-show');

// Normalize Omeka's possible null, single-value, and array return types.
$valueList = static function ($subject, $term) {
    $propertyValues = $subject->value($term, ['all' => true]);
    return is_array($propertyValues)
        ? $propertyValues
        : ($propertyValues ? [$propertyValues] : []);
};

$isRtlTerm = static function ($term) {
    return (bool) preg_match('/(?:Yiddish|Hebrew)$/', $term);
};

// Retain Omeka's data-type rendering, adding the adaptations used in the Work accordion for booleans, resource links, and Hebrew-script values.
$renderValue = function ($value, $rtl = false, $includeAnnotations = true) use ($escape, $translate, $lang, $showValueAnnotations) {
    if ('boolean' === $value->type()) {
        $isTrue = in_array(strtolower(trim((string) $value->value())), ['1', 'true'], true);
        $label = $translate($isTrue ? 'Yes' : 'No');
        $html = sprintf(
            '<span class="work-boolean work-boolean-%s"><span aria-hidden="true">%s</span><span class="sr-only">%s</span></span>',
            $isTrue ? 'true' : 'false',
            $isTrue ? '&#10003;' : '&#10005;',
            $escape($label)
        );
    } elseif (0 === strpos($value->type(), 'resource')) {
        $linkedResource = $value->valueResource();
        $html = $linkedResource
            ? sprintf(
                '<a href="%s">%s</a>',
                $escape($linkedResource->url()),
                $escape($linkedResource->displayTitle(null, $lang))
            )
            : '';
    } else {
        $html = $value->asHtml();
    }

    $attributes = '';
    if ($value->lang()) {
        $attributes .= sprintf(' lang="%s"', $escape($value->lang()));
    } elseif ($rtl) {
        $attributes .= ' lang="yi"';
    }
    if ($rtl) {
        $attributes .= ' dir="rtl"';
    }

    $valueHtml = sprintf('<span class="work-value"%s>%s</span>', $attributes, $html);
    $annotation = $value->valueAnnotation();
    if ($annotation && $showValueAnnotations && $includeAnnotations) {
        $expanded = 'expanded' === $showValueAnnotations;
        $toggleLabel = $escape($translate($expanded ? 'Collapse' : 'Expand'));
        $annotationLabel = $escape($translate('Has annotation'));
        $valueHtml .= sprintf(
            ' <a href="#" class="%s" aria-label="%s"><span class="has-annotation o-icon-annotation" role="img" title="%s" aria-label="%s"></span></a><div class="collapsible annotation">%s</div>',
            $expanded ? 'collapse' : 'expand',
            $toggleLabel,
            $annotationLabel,
            $annotationLabel,
            $annotation->displayValues()
        );
    }

    return $valueHtml;
};

$hasAnyValues = static function ($subject, array $fields) use ($valueList) {
    foreach ($fields as $term => $label) {
        if ($valueList($subject, $term)) {
            return true;
        }
    }
    return false;
};

// Give longer descriptive fields the full row within the metadata grid.
$fullWidthTerms = ['yido:specialFeatures', 'yido:researchLiterature', 'yido:remarks'];
$renderFields = function ($subject, array $fields) use ($escape, $valueList, $isRtlTerm, $renderValue, $fullWidthTerms) {
    ob_start();
    foreach ($fields as $term => $label) {
        $propertyValues = $valueList($subject, $term);
        if (!$propertyValues) {
            continue;
        }
        $fieldClasses = ['work-field'];
        if (in_array($term, $fullWidthTerms, true)) {
            $fieldClasses[] = 'work-field-full-width';
        }
        if (count($propertyValues) === 1 && 'boolean' === reset($propertyValues)->type()) {
            $fieldClasses[] = 'work-field-boolean';
        }
        ?>
        <div class="<?php echo implode(' ', $fieldClasses); ?>">
            <dt><?php echo $escape($label); ?></dt>
            <dd>
                <ul class="work-value-list<?php echo 'yido:researchLiterature' === $term ? ' work-research-literature' : ''; ?>">
                    <?php foreach ($propertyValues as $propertyValue): ?>
                    <li><?php echo $renderValue($propertyValue, $isRtlTerm($term)); ?></li>
                    <?php endforeach; ?>
                </ul>
            </dd>
        </div>
        <?php
    }
    return ob_get_clean();
};

// Full metadata for standalone records; Work previews use the first two sections.
$titlesSectionLabel = $translate('Titles and Content');
$featuresSectionLabel = $translate('Features');
$holdingsSectionLabel = $translate('Holdings and access');
$notesSectionLabel = $translate('Notes and bibliography');
$witnessSections = [
    $titlesSectionLabel => [
        'yido:manuscriptName' => $translate('Manuscript name'),
        'yido:shortTitleAlt' => $translate('Alternative title'),
        'yido:shortTitleYiddishAlt' => $translate('Alternative title (Yiddish)'),
        'yido:incipit' => $translate('Incipit'),
        'yido:incipitYiddish' => $translate('Incipit (Yiddish)'),
        'yido:incipitTranslationEng' => $translate('Incipit translation'),
        'yido:columnTitles' => $translate('Column titles'),
        'yido:columnTitlesYiddish' => $translate('Column titles (Yiddish)'),
        'yido:languages' => $translate('Languages'),
    ],
    $translate('Creation and publication') => [
        'dcterms:creator' => $translate('Creator'),
        'yido:creator' => $translate('Creator'),
        'yido:creatorYiddish' => $translate('Creator (Yiddish)'),
        'yido:publisher' => $translate('Printer / publisher'),
        'yido:publisherYiddish' => $translate('Printer / publisher (Yiddish)'),
        'yido:placeOfPublication' => $translate('Place of publication'),
        'yido:timeOfPublication' => $translate('Date of publication'),
        'yido:jewishTimeOfPublication' => $translate('Jewish date of publication'),
        'yido:compiler' => $translate('Compiler'),
        'yido:compilerYiddish' => $translate('Compiler (Yiddish)'),
        'yido:redactor' => $translate('Editor'),
        'yido:redactorYiddish' => $translate('Editor (Yiddish)'),
        'yido:author' => $translate('Author'),
        'yido:authorYiddish' => $translate('Author (Yiddish)'),
        'yido:placeOfCreation' => $translate('Place of creation'),
        'yido:timeOfCreation' => $translate('Date of creation'),
        'yido:jewishTimeOfCreation' => $translate('Jewish date of creation'),
    ],
    $translate('Physical description') => [
        'yido:type' => $translate('Type'),
        'yido:material' => $translate('Material'),
        'yido:format' => $translate('Format'),
        'yido:typeface' => $translate('Typeface'),
        'yido:script' => $translate('Script'),
        'yido:scriptType' => $translate('Script type'),
        'yido:scriptTrace' => $translate('Script characteristics'),
        'yido:size' => $translate('Size'),
        'yido:length' => $translate('Length'),
        'yido:width' => $translate('Width'),
        'yido:scriptSpace' => $translate('Script space'),
        'yido:numberOfPages' => $translate('Pages / leaves / folios'),
        'yido:numberingOfPages' => $translate('Pagination'),
        'yido:numberOfColumns' => $translate('Columns'),
        'yido:numberOfLines' => $translate('Lines per page'),
    ],
    $featuresSectionLabel => [
        'yido:catchwords' => $translate('Catchwords'),
        'yido:illustrations' => $translate('Illustrations'),
        'yido:capitalLetters' => $translate('Initials / capital letters'),
        'yido:glosses' => $translate('Glosses'),
        'yido:marginalia' => $translate('Marginalia'),
        'yido:rubrications' => $translate('Rubrications'),
        'yido:specialFeatures' => $translate('Special features'),
    ],
    $holdingsSectionLabel => [
        'yido:institution' => $translate('Institutions'),
        'yido:place' => $translate('Places'),
        'yido:callNumber' => $translate('Shelfmarks'),
        'yido:digitalCopy' => $translate('Digital copies'),
    ],
    $notesSectionLabel => [
        'yido:remarks' => $translate('Remarks'),
        'yido:reprintOf' => $translate('Reprint of'),
        'yido:researchLiterature' => $translate('Research literature'),
    ],
];

$contents = $valueList($resource, 'yido:content');

$contextFields = [
    'yido:origin' => $translate('Origin'),
    'yido:institution' => $translate('Institution'),
    'yido:place' => $translate('Place'),
];

// Omeka groups incoming values by display label. Index the source items by
// property term instead, respecting the site's incoming-resource filter.
$siteId = $this->siteSetting('exclude_resources_not_in_site') ? $this->currentSite()->id() : null;
$incomingValues = [];
foreach ($resource->subjectValues(null, null, null, null, $siteId) as $subjectValues) {
    foreach ($subjectValues as $subjectValueData) {
        $subjectValue = $subjectValueData['val'];
        $source = $subjectValue->resource();
        if ($source && $source->isPublic() && 'items' === $source->resourceName()) {
            $incomingValues[$subjectValue->property()->term()][$source->id()] = $source;
        }
    }
}
$incomingItems = function ($term) use ($resource, $incomingValues, $siteId) {
    if (!empty($incomingValues[$term])) {
        return $incomingValues[$term];
    }
    // Resource-page blocks may omit subject values; retain an API fallback.
    $query = [
        'is_public' => true,
        'property' => [[
            'property' => $term,
            'type' => 'res',
            'text' => $resource->id(),
        ]],
    ];
    if ($siteId) {
        $query['site_id'] = $siteId;
    }
    $items = [];
    foreach ($this->api()->search('items', $query)->getContent() as $source) {
        if ($source->isPublic()) {
            $items[$source->id()] = $source;
        }
    }
    return $items;
};

// A collection context (for example a Genizah) links through yido:content.
$contexts = $incomingItems('yido:content');
$reprints = $incomingItems('yido:reprintOf');

// Some texts identify their parent only through isPartOf. Add those to Contents
// without duplicating outgoing content entries or losing their annotations.
$incomingContents = $incomingItems('yido:isPartOf');
foreach ($contents as $contentValue) {
    $contentResource = $contentValue->valueResource();
    if ($contentResource) {
        unset($incomingContents[$contentResource->id()]);
    }
}

// Parent navigation lives beneath the class badge, outside this metadata view.
if ($isContainedWork) {
    $contexts = [];
}

// Structured fields are removed from the generic fallback to avoid duplicate output. The title fields are already represented by the page heading.
$handledTerms = ['dcterms:title', 'yido:shortTitle', 'yido:shortTitleYiddish', 'yido:content'];
foreach ($witnessSections as $sectionFields) {
    $handledTerms = array_merge($handledTerms, array_keys($sectionFields));
}

$valueData = $values instanceof Traversable ? iterator_to_array($values, false) : $values;
$otherValues = [];
foreach ($valueData as $propertyData) {
    if ($isContainedWork && 'yido:isPartOf' === $propertyData['property']->term()) {
        // Omit the links moved to the heading. Keep literal, unexpected, and
        // annotated values available through the normal metadata fallback.
        $propertyData['values'] = array_filter($propertyData['values'], static function ($value) use ($containedWorkClasses, $resourceClassTerm) {
            $parent = $value->valueResource();
            $parentClass = $parent ? $parent->resourceClass() : null;
            return !$parent || !$parent->isPublic() || 'items' !== $parent->resourceName()
                || !$parentClass || $parentClass->term() !== $containedWorkClasses[$resourceClassTerm]
                || $value->valueAnnotation();
        });
        if (!$propertyData['values']) {
            continue;
        }
    }
    if (!in_array($propertyData['property']->term(), $handledTerms, true)) {
        $otherValues[] = $propertyData;
    }
}
?>

<div class="work-view standalone-witness-view">
    <div class="witness-card-content standalone-witness-content">
        <?php if ($contexts && !$contextsInHoldings): ?>
        <section class="witness-context" aria-labelledby="witness-context-<?php echo $resource->id(); ?>">
            <h3 id="witness-context-<?php echo $resource->id(); ?>"><?php echo $escape($translate('Collection context')); ?></h3>
            <?php foreach ($contexts as $context): ?>
            <article class="context-card">
                <h4><a href="<?php echo $escape($context->url()); ?>"><?php echo $escape($context->displayTitle(null, $lang)); ?></a></h4>
                <?php if ($hasAnyValues($context, $contextFields)): ?>
                <dl class="work-field-grid">
                    <?php echo $renderFields($context, $contextFields); ?>
                </dl>
                <?php endif; ?>
            </article>
            <?php endforeach; ?>
        </section>
        <?php endif; ?>

        <?php foreach ($witnessSections as $sectionLabel => $sectionFields): ?>
            <?php $hasSectionValues = $hasAnyValues($resource, $sectionFields); ?>
            <?php $showContexts = $contextsInHoldings && $contexts && $sectionLabel === $holdingsSectionLabel; ?>
            <?php $showReprints = $reprints && $sectionLabel === $notesSectionLabel; ?>
            <?php if ($hasSectionValues || $showContexts || $showReprints): ?>
            <section class="witness-section<?php echo $sectionLabel === $featuresSectionLabel ? ' witness-features' : ''; ?>">
                <h3><?php echo $escape($sectionLabel); ?></h3>
                <dl class="work-field-grid">
                    <?php if ($sectionLabel === $holdingsSectionLabel && in_array($resourceClassTerm, ['yido:Manuscript', 'yido:PrintedBook'], true)): ?>
                        <?php echo $this->partial('common/holdings-fields', [
                            'resource' => $resource,
                            'fields' => $sectionFields,
                            'valueList' => $valueList,
                            'renderValue' => $renderValue,
                            'renderFields' => $renderFields,
                        ]); ?>
                    <?php else: ?>
                        <?php echo $renderFields($resource, $sectionFields); ?>
                    <?php endif; ?>
                    <?php if ($showContexts): ?>
                        <?php foreach ($contexts as $context): ?>
                        <?php
                        $contextClass = $context->resourceClass();
                        $contextLabel = $contextClass ? $translate($contextClass->label()) : $translate('Collection');
                        ?>
                        <div class="work-field">
                            <dt><?php echo $escape($contextLabel); ?></dt>
                            <dd>
                                <ul class="work-value-list">
                                    <li><span class="work-value"><a href="<?php echo $escape($context->url()); ?>"><?php echo $escape($context->displayTitle(null, $lang)); ?></a></span></li>
                                </ul>
                            </dd>
                        </div>
                        <?php endforeach; ?>
                    <?php endif; ?>
                    <?php if ($showReprints): ?>
                    <div class="work-field">
                        <dt><?php echo $escape($translate('Reprints')); ?></dt>
                        <dd>
                            <ul class="work-value-list">
                                <?php foreach ($reprints as $reprint): ?>
                                <li><span class="work-value"><a href="<?php echo $escape($reprint->url()); ?>"><?php echo $escape($reprint->displayTitle(null, $lang)); ?></a></span></li>
                                <?php endforeach; ?>
                            </ul>
                        </dd>
                    </div>
                    <?php endif; ?>
                </dl>
            </section>
            <?php endif; ?>

            <?php if ($sectionLabel === $titlesSectionLabel && ($contents || $incomingContents)): ?>
            <section class="witness-section witness-contents">
                <h3><?php echo $escape($translate('Contents')); ?></h3>
                <ul class="work-value-list">
                    <?php foreach ($contents as $contentValue): ?>
                    <li>
                        <?php echo $renderValue($contentValue, false, false); ?>
                        <?php $contentAnnotation = $contentValue->valueAnnotation(); ?>
                        <?php if ($contentAnnotation && $showValueAnnotations): ?>
                        <div class="contents-annotation">
                            <?php echo $contentAnnotation->displayValues(); ?>
                        </div>
                        <?php endif; ?>
                    </li>
                    <?php endforeach; ?>
                    <?php foreach ($incomingContents as $contentResource): ?>
                    <li><span class="work-value"><a href="<?php echo $escape($contentResource->url()); ?>"><?php echo $escape($contentResource->displayTitle(null, $lang)); ?></a></span></li>
                    <?php endforeach; ?>
                </ul>
            </section>
            <?php endif; ?>
        <?php endforeach; ?>

        <?php echo $this->partial('common/resource-further-information', [
            'resource' => $resource,
            'values' => $otherValues,
        ]); ?>
    </div>
</div>
