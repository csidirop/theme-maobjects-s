<?php
$escape = $this->plugin('escapeHtml');
$translate = $this->plugin('translate');
$filterLocale = (bool) $this->siteSetting('filter_locale_values');
$lang = $this->lang();
$valueLang = $filterLocale ? [$lang, ''] : null;

$this->headScript()->appendFile($this->assetUrl('js/browse.js'));
if (isset($itemSet)) {
    $this->headLink()->prependStylesheet($this->assetUrl('css/resource-page-blocks.css', 'Omeka'));
}
$this->htmlElement('body')->appendAttribute('class', 'item resource browse');

$query = $this->params()->fromQuery();
// Adjust displayed filters without changing the query used by browse controls.
$filterQuery = $query;
?>
<?php if (isset($itemSet)): ?>
<?php $this->htmlElement('body')->appendAttribute('class', 'item-set show');
    $query['item_set_id'] = $itemSet->id(); ?>
    <?php echo $this->pageTitle($itemSet->displayTitle(null, $valueLang), 2); ?>
    <h3><?php echo $translate('Item Set'); ?></h3>
    <div class="resource-metadata">
        <?php echo $this->resourcePageBlocks($itemSet)->getBlocks(); ?>
    </div>
    <?php echo $this->partial('common/metadata-formats', ['resources' => $itemSet]); ?>
    <?php echo $this->pageTitle($translate('Items'), 3); ?>
<?php else: ?>
    <?php
    $browseTitle = $translate('Items');
    // Only a single template can supply the heading for the whole result list.
    $templateIds = (array) ($query['resource_template_id'] ?? []);
    $templateId = reset($templateIds);
    if (count($templateIds) === 1 && is_scalar($templateId)
        && ctype_digit((string) $templateId) && (int) $templateId > 0
    ) {
        $templates = $this->api()->search('resource_templates', ['id' => (int) $templateId, 'limit' => 1])->getContent();
        if ($templates) {
            $template = reset($templates);
            $resourceClass = $template->resourceClass();
            // Prefer the readable class name over a versioned template label.
            $browseTitle = $resourceClass ? $translate($resourceClass->label()) : $template->label();
            // The heading already identifies this template; keep other filters.
            unset($filterQuery['resource_template_id']);
        }
    }
    echo $this->pageTitle($browseTitle, 2);
    ?>
<?php endif; ?>

<?php echo $this->searchFilters(null, $filterQuery); ?>

<?php
$browseLayout = $this->plugin('BrowseLayout');
$layout = $browseLayout();
$currentLayout = $layout['layout'];
?>
<div class="browse-results" data-browse-results>
<div class="browse-controls">
    <?php if ($layout['toggle']) echo $this->partial('common/browse-layout-toggle', ['layout' => $currentLayout]); ?>
    <?php echo $this->hyperlink($translate('Advanced search'), $this->url('site/resource', ['controller' => 'item', 'action' => 'search'], ['query' => $query], true), ['class' => 'advanced-search']); ?>
    <?php echo $this->pagination(); ?>
    <?php echo $this->browse()->renderSortSelector('items'); ?>
</div>
<?php $this->trigger('view.browse.before'); ?>
<ul class="resource-list <?php echo $currentLayout; ?>">
    <?php
    $headingTerm = $this->siteSetting('browse_heading_property_term');
    $bodyTerm = $this->siteSetting('browse_body_property_term');
    ?>    
    <?php foreach ($items as $item): ?>
    <?php
    $heading = $headingTerm ? $item->value($headingTerm, ['default' => $translate('[Untitled]'), 'lang' => $valueLang]) : $item->displayTitle(null, $valueLang);
    $body = $bodyTerm ? $item->value($bodyTerm, ['lang' => $valueLang]) : $item->displayDescription(null, $valueLang);
    echo $this->partial('common/browse-card', ['resource' => $item, 'heading' => $heading, 'body' => $body]);
    ?>
    <?php endforeach; ?>
</ul>
<div class="browse-controls">
    <?php echo $this->pagination(); ?>
</div>
<?php $this->trigger('view.browse.after'); ?>
<?php echo $this->partial('common/metadata-formats', ['resources' => $items]); ?>
</div>
